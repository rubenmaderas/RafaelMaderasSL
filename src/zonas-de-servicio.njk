---
layout: layouts/base.njk
permalink: /zonas-de-servicio/
pageKey: zonas
breadcrumb: "Zonas de servicio"
faqGroup: zonas
---
{#- Textos y localidades: contenido/paginas/zonas.json (/admin → Páginas → Zonas de servicio).
    No se crean páginas independientes por municipio (evita páginas puerta). -#}
{%- from "macros/icons.njk" import icon -%}
{%- set c = contenido.paginas.zonas -%}
<header class="page-hero container">
  <p class="eyebrow">{{ c.cabecera.antetitulo | t }}</p>
  <h1>{{ c.cabecera.titulo | t }}</h1>
  <p class="lead">{{ c.cabecera.entradilla | mdi | safe }}</p>
</header>

<div class="container">
  {% image "jaen", "(min-width: 72em) 72rem, calc(100vw - 3rem)", { eager: true, class: "media--wide", widths: [480, 640, 960, 1280, 1920] } %}
</div>

<section class="section" aria-labelledby="titulo-capital">
  <div class="container">
    {%- set zoneBlocks = [
      { key: "capital", id: "titulo-capital", label: "" },
      { key: "cercanias", id: "titulo-cercanias", label: "Municipios cercanos a Jaén" },
      { key: "provincia", id: "titulo-provincia", label: "Otros municipios de la provincia de Jaén" },
      { key: "andalucia", id: "titulo-andalucia", label: "Provincias andaluzas" }
    ] %}
    {%- for block in zoneBlocks %}
    {%- set zone = c[block.key] %}
    <div class="zone-block">
      <p class="eyebrow">{{ zone.antetitulo | t }}</p>
      <h2 id="{{ block.id }}">{{ zone.titulo | t }}</h2>
      {{ zone.texto | md | safe }}
      {%- if zone.localidades and zone.localidades.length %}
      <ul class="tag-list" aria-label="{{ block.label or zone.titulo | t }}">
        {%- for localidad in zone.localidades %}
        <li>{{ localidad | t }}</li>
        {%- endfor %}
      </ul>
      {%- endif %}
    </div>
    {%- endfor %}
  </div>
</section>

<section class="section section--sand" aria-labelledby="titulo-otra-localidad">
  <div class="container split split--wide-text">
    <div>
      <h2 id="titulo-otra-localidad">{{ c.otraLocalidad.titulo | t }}</h2>
      {{ c.otraLocalidad.texto | md | safe }}
    </div>
    <div class="btn-group" data-hides-mobile-cta>
      <a class="btn btn--primary" href="{{ site.phone.href }}">{{ icon("phone") }}<span>Llamar ahora</span></a>
      <a class="btn btn--accent" href="{{ site.whatsapp.href }}" target="_blank" rel="noopener">{{ icon("whatsapp") }}<span>Escribir por WhatsApp</span><span class="visually-hidden"> (se abre en una nueva pestaña)</span></a>
    </div>
  </div>
</section>

{%- if faq[faqGroup].length %}
<section class="section" id="preguntas-frecuentes" aria-labelledby="titulo-faq">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{{ c.preguntas.antetitulo | t }}</p>
      <h2 id="titulo-faq">{{ c.preguntas.titulo | t }}</h2>
    </div>
    {% include "partials/faq.njk" %}
  </div>
</section>
{%- endif %}
