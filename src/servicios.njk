---
layout: layouts/base.njk
permalink: /servicios/
pageKey: servicios
breadcrumb: "Servicios"
faqGroup: servicios
---
{#- Textos: contenido/paginas/servicios.json y contenido/servicios.json (/admin). -#}
{%- from "macros/icons.njk" import icon -%}
{%- set c = contenido.paginas.servicios -%}
<header class="page-hero container">
  <p class="eyebrow">{{ c.cabecera.antetitulo | t }}</p>
  <h1>{{ c.cabecera.titulo | t }}</h1>
  <p class="lead">{{ c.cabecera.entradilla | mdi | safe }}</p>
  <div class="btn-group" data-hides-mobile-cta>
    <a class="btn btn--primary" href="{{ site.phone.href }}">{{ icon("phone") }}<span>Llamar ahora</span></a>
    <a class="btn btn--outline" href="{{ site.whatsapp.href }}" target="_blank" rel="noopener">{{ icon("whatsapp") }}<span>Escribir por WhatsApp</span><span class="visually-hidden"> (se abre en una nueva pestaña)</span></a>
  </div>
</header>

<section class="section section--surface" aria-labelledby="titulo-yeso">
  <div class="container">
    <div class="split split--wide-text">
      <div class="section-head">
        <p class="eyebrow">{{ c.yeso.antetitulo | t }}</p>
        <h2 id="titulo-yeso">{{ c.yeso.titulo | t }}</h2>
        <p>{{ c.yeso.entradilla | mdi | safe }}</p>
      </div>
      {% image "acabado_interior", "(min-width: 72em) 28rem, (min-width: 48em) 38vw, calc(100vw - 3rem)", { class: "media--landscape" } %}
    </div>

    <div class="services-list">
      {%- for service in services.yeso %}
      <article class="service" id="{{ service.id }}">
        <h3>{{ service.titulo | t }}</h3>
        <div>
          {{ service.descripcion | md | safe }}
        </div>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section" aria-labelledby="titulo-obra">
  <div class="container">
    <div class="split split--wide-text">
      <div class="section-head">
        <p class="eyebrow">{{ c.obra.antetitulo | t }}</p>
        <h2 id="titulo-obra">{{ c.obra.titulo | t }}</h2>
        <p>{{ c.obra.entradilla | mdi | safe }}</p>
      </div>
      {% image "albanileria", "(min-width: 72em) 28rem, (min-width: 48em) 38vw, calc(100vw - 3rem)", { class: "media--landscape" } %}
    </div>

    <div class="services-list">
      {#- Aquí solo el resumen: la descripción completa está en /reformas/, la página que
          debe posicionar «reformas en Jaén». Repetirla aquí haría competir a las dos. #}
      {%- for service in services.reformas %}
      <article class="service" id="{{ service.id }}">
        <h3>{{ service.titulo | t }}</h3>
        <div>
          <p>{{ service.resumen | mdi | safe }}</p>
          <p><a class="link-arrow" href="/reformas/#{{ service.id }}">{{ service.titulo | t }} en Jaén {{ icon("arrow", 18) }}</a></p>
        </div>
      </article>
      {%- endfor %}
    </div>
    <p><a class="link-arrow" href="/reformas/">{{ c.obra.enlace | t }} {{ icon("arrow", 18) }}</a></p>
  </div>
</section>

<section class="section section--sand" aria-labelledby="titulo-consejos">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{{ c.consejos.antetitulo | t }}</p>
      <h2 id="titulo-consejos">{{ c.consejos.titulo | t }}</h2>
      <p>{{ c.consejos.entradilla | mdi | safe }}</p>
    </div>
    <div class="grid grid--3">
      {%- for card in c.consejos.tarjetas %}
      <article class="card">
        <h3>{{ card.titulo | t }}</h3>
        {{ card.texto | md | safe }}
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

{%- if faq[faqGroup].length %}
<section class="section" id="preguntas-frecuentes" aria-labelledby="titulo-faq">
  <div class="container">
    <div class="section-head section-head--center">
      <p class="eyebrow">{{ c.preguntas.antetitulo | t }}</p>
      <h2 id="titulo-faq">{{ c.preguntas.titulo | t }}</h2>
    </div>
    {% include "partials/faq.njk" %}
  </div>
</section>
{%- endif %}