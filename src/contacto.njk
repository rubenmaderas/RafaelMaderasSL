---
layout: layouts/base.njk
permalink: /contacto/
pageKey: contacto
breadcrumb: "Contacto"
hideFinalCta: true
---
{#- Textos: contenido/paginas/contacto.json (/admin → Páginas → Contacto). Los botones
    usan siempre el teléfono y el correo de «Datos de la empresa». -#}
{%- from "macros/icons.njk" import icon -%}
{%- set c = contenido.paginas.contacto -%}
<header class="page-hero page-hero--compact container">
  <p class="eyebrow">{{ c.cabecera.antetitulo | t }}</p>
  <h1>{{ c.cabecera.titulo | t }}</h1>
  <p class="lead">{{ c.cabecera.entradilla | mdi | safe }}</p>
</header>

<section class="section section--tight-top" aria-label="Medios de contacto">
  <div class="container">
    <div class="contact-cards" data-hides-mobile-cta>
      <article class="contact-card">
        <span class="contact-card__icon">{{ icon("phone", 24) }}</span>
        <h2>{{ c.medios.telefono.titulo | t }}</h2>
        {{ c.medios.telefono.texto | md | safe }}
        <a class="btn btn--primary" href="{{ site.phone.href }}">{{ icon("phone") }}<span>Llamar al {{ site.phone.display }}</span></a>
      </article>
      <article class="contact-card">
        <span class="contact-card__icon">{{ icon("whatsapp", 24) }}</span>
        <h2>{{ c.medios.whatsapp.titulo | t }}</h2>
        {{ c.medios.whatsapp.texto | md | safe }}
        <a class="btn btn--accent" href="{{ site.whatsapp.href }}" target="_blank" rel="noopener">{{ icon("whatsapp") }}<span>Escribir por WhatsApp</span><span class="visually-hidden"> (se abre en una nueva pestaña)</span></a>
      </article>
      <article class="contact-card">
        <span class="contact-card__icon">{{ icon("mail", 24) }}</span>
        <h2>{{ c.medios.correo.titulo | t }}</h2>
        {{ c.medios.correo.texto | md | safe }}
        <a class="btn btn--outline" href="{{ site.email.href }}">{{ icon("mail") }}<span>{{ site.email.address }}</span></a>
      </article>
    </div>
  </div>
</section>

<section class="section section--surface" aria-labelledby="titulo-mensaje">
  <div class="container split split--wide-text split--top">
    <div>
      <h2 id="titulo-mensaje">{{ c.mensaje.titulo | t }}</h2>
      <p>{{ c.mensaje.entradilla | mdi | safe }}</p>
      {%- if c.mensaje.lista.length %}
      <ul class="check-list">
        {%- for item in c.mensaje.lista %}
        <li>{{ icon("check", 18) }}<span>{{ item | mdi | safe }}</span></li>
        {%- endfor %}
      </ul>
      {%- endif %}
    </div>
    <div>
      <h2 id="titulo-disponibilidad">{{ c.disponibilidad.titulo | t }}</h2>
      {{ c.disponibilidad.texto | md | safe }}
      <h2 id="titulo-zona">{{ c.zona.titulo | t }}</h2>
      {{ c.zona.texto | md | safe }}
    </div>
  </div>
</section>

<section class="section" aria-labelledby="titulo-datos">
  <div class="container">
    <h2 id="titulo-datos">{{ c.datos.titulo | t }}</h2>
    <dl class="contact-data">
      <div><dt>Empresa</dt><dd>{{ site.name }}</dd></div>
      <div><dt>Teléfono y WhatsApp</dt><dd><a href="{{ site.phone.href }}">{{ site.phone.displayIntl }}</a></dd></div>
      <div><dt>Correo electrónico</dt><dd><a href="{{ site.email.href }}">{{ site.email.address }}</a></dd></div>
      <div><dt>Zona de servicio</dt><dd>{{ c.datos.zona | t }}</dd></div>
      {%- if site.hours.length %}
      <div><dt>Horario</dt><dd>{% for h in site.hours %}{{ h.label }}: {{ h.display }}{% if not loop.last %}<br>{% endif %}{% endfor %}</dd></div>
      {%- endif %}
    </dl>
    {%- if c.datos.nota %}
    <p class="small">{{ c.datos.nota | mdi | safe }}</p>
    {%- endif %}
  </div>
</section>