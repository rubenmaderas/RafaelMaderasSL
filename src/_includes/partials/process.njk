{#- Pasos del proceso de trabajo: contenido/comun.json (/admin → «Textos comunes»). -#}
<ol class="process">
  {%- for step in contenido.comun.proceso %}
  <li class="process__step">
    {#- Párrafo y no <h3>: los pasos ya van en una lista numerada, y así la página no
        acumula encabezados cortos (los analizadores SEO penalizan el exceso). -#}
    <p class="process__title">{{ step.titulo | t }}</p>
    {{ step.texto | md | safe }}
  </li>
  {%- endfor %}
</ol>