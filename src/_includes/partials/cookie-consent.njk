{#-
  Panel de consentimiento de cookies.
  Solo se incluye si site.cookieConsent.enabled es true (ver README).
  Los tres botones principales tienen el mismo peso visual, como exige la
  Guía sobre el uso de las cookies de la AEPD.
-#}
<section class="consent" role="dialog" aria-modal="false" aria-labelledby="consent-titulo" data-consent data-storage-key="{{ site.cookieConsent.storageKey }}" hidden>
  <h2 id="consent-titulo">Cookies en esta web</h2>
  <p>
    Usamos cookies técnicas necesarias para que la web funcione y, solo si nos das permiso, cookies de
    {% for c in site.cookieConsent.categories %}{{ c.label | lower }}{% if not loop.last %}{% if loop.revindex == 2 %} y {% else %}, {% endif %}{% endif %}{% endfor %}.
    Puedes aceptarlas, rechazarlas o elegir cuáles permites, y cambiar de opinión cuando quieras desde el enlace «Configurar cookies» del pie de página.
    Más información en la <a href="/politica-de-cookies/">Política de cookies</a>.
  </p>
  <form data-consent-form>
    <fieldset class="consent__options" data-consent-options hidden>
      <legend class="visually-hidden">Categorías de cookies</legend>
      <label class="consent__option">
        <input type="checkbox" checked disabled>
        <span><strong>Técnicas (siempre activas)</strong><span>Necesarias para el funcionamiento básico de la web y para recordar tu elección sobre cookies.</span></span>
      </label>
      {%- for c in site.cookieConsent.categories %}
      <label class="consent__option">
        <input type="checkbox" name="{{ c.id }}" data-consent-category="{{ c.id }}">
        <span><strong>{{ c.label }}</strong><span>{{ c.description }}</span></span>
      </label>
      {%- endfor %}
    </fieldset>
    <div class="consent__actions">
      <button type="button" class="btn btn--outline btn--sm" data-consent-reject>Rechazar</button>
      <button type="button" class="btn btn--outline btn--sm" data-consent-configure aria-expanded="false">Configurar</button>
      <button type="button" class="btn btn--outline btn--sm" data-consent-accept>Aceptar</button>
    </div>
    <p class="consent__save" data-consent-save-wrap hidden>
      <button type="submit" class="btn btn--primary btn--sm">Guardar mi selección</button>
    </p>
  </form>
</section>
