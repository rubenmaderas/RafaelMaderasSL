{%- from "macros/icons.njk" import icon -%}
<aside class="mobile-cta" aria-label="Contacto rápido" data-mobile-cta>
  <a class="mobile-cta__btn mobile-cta__btn--call" href="{{ site.phone.href }}">
    {{ icon("phone", 18) }}<span>Llamar</span>
  </a>
  <a class="mobile-cta__btn mobile-cta__btn--whatsapp" href="{{ site.whatsapp.href }}" target="_blank" rel="noopener">
    {{ icon("whatsapp", 18) }}<span>WhatsApp</span><span class="visually-hidden"> (se abre en una nueva pestaña)</span>
  </a>
</aside>
