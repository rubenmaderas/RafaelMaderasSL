{#- Preguntas frecuentes de la página (faqGroup en el front matter): mismo contenido que su JSON-LD FAQPage. -#}
<div class="faq">
  {%- for item in faq[faqGroup] %}
  <details class="faq__item"{% if loop.first %} open{% endif %}>
    <summary class="faq__question">{{ item.question }}</summary>
    <div class="faq__answer">
      {%- for paragraph in item.paragraphs %}
      <p>{{ paragraph }}</p>
      {%- endfor %}
    </div>
  </details>
  {%- endfor %}
</div>