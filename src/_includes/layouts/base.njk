{%- from "macros/icons.njk" import icon -%}
{#- Las páginas editables desde /admin indican "pageKey" y toman su SEO de contenido/paginas/<pageKey>.json. -#}
{%- if pageKey %}
  {%- set pageSeo = contenido.paginas[pageKey].seo %}
  {%- set pageTitle = pageSeo.titulo | t %}
  {%- set pageDescription = pageSeo.descripcion | t %}
{%- else %}
  {%- set pageTitle = title %}
  {%- set pageDescription = description %}
{%- endif -%}
<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  {% cspMeta %}
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script>{{ inlineScript.code | safe }}</script>
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  {%- set isErrorPage = page.url == "/404.html" %}
  {%- if not isErrorPage %}
  <link rel="canonical" href="{{ page.url | absoluteUrl }}">
  {%- endif %}
  {%- if noindex %}
  <meta name="robots" content="noindex, follow">
  {%- else %}
  <meta name="robots" content="index, follow, max-image-preview:large">
  {%- endif %}
  <meta name="theme-color" content="{{ site.seo.themeColor }}">
  <meta name="format-detection" content="telephone=no">

  <link rel="preload" href="/assets/fonts/manrope-latin-wght.woff2" as="font" type="font/woff2" crossorigin>
  {% inlineCss %}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <meta property="og:type" content="website">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ ogTitle or pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ page.url | absoluteUrl }}">
  <meta property="og:image" content="{{ site.seo.ogImage | absoluteUrl }}">
  <meta property="og:image:width" content="{{ site.seo.ogImageWidth }}">
  <meta property="og:image:height" content="{{ site.seo.ogImageHeight }}">
  <meta property="og:image:alt" content="{{ site.seo.ogImageAlt }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ ogTitle or pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ site.seo.ogImage | absoluteUrl }}">
  <meta name="twitter:image:alt" content="{{ site.seo.ogImageAlt }}">

  {%- if not isErrorPage %}
  <script type="application/ld+json">{{ structuredData.forPage({ url: page.url, title: pageTitle, description: pageDescription, breadcrumb: breadcrumb, includeFaq: faqSchema }) | jsonLd | safe }}</script>
  {%- endif %}

  <script src="{{ '/assets/js/main.js' | asset }}" defer></script>
  {%- if site.cookieConsent.enabled %}
  <script src="{{ '/assets/js/consent.js' | asset }}" defer></script>
  {%- endif %}
</head>
<body class="{{ bodyClass }}">
  <a class="skip-link" href="#contenido">Saltar al contenido</a>

  {% include "partials/header.njk" %}

  <main id="contenido" tabindex="-1"{% if breadcrumb %} class="main--inner"{% endif %}>
    {%- if breadcrumb %}
    {% include "partials/breadcrumbs.njk" %}
    {%- endif %}
    {{ content | safe }}

    {%- if not hideFinalCta %}
    {% include "partials/cta-final.njk" %}
    {%- endif %}
  </main>

  {% include "partials/footer.njk" %}
  {% include "partials/mobile-cta.njk" %}

  {%- if site.cookieConsent.enabled %}
  {% include "partials/cookie-consent.njk" %}
  {%- endif %}
</body>
</html>
